def test_measure_xyz_algorithmic_preservation():
    """Ensure refactored code produces identical results to original."""
    
    # Setup realistic test data
    np.random.seed(42)  # Reproducibility
    image = np.random.rand(100, 100).astype(np.float64)
    labels = np.zeros((100, 100), dtype=np.int32)
    labels[20:40, 20:40] = 1
    labels[60:80, 60:80] = 2
    
    # Run refactored library function
    from cellprofiler_library.modules._measurexyz import measure_xyz
    result = measure_xyz(
        image=image,
        image_name="TestImage",
        param1=1.0,
        param2=5,
        object_name="TestObjects",
        labels=labels
    )
    
    # Verify structure
    assert isinstance(result, LibraryMeasurements)
    assert "TestObjects" in result.objects
    
    # Verify shape (2 objects in test data)
    for feature_values in result.objects["TestObjects"].values():
        assert len(feature_values) == 2, "Should have 2 objects"
    
    # Verify statistical summaries exist
    object_features = list(result.objects["TestObjects"].keys())
    for obj_feature in object_features:
        assert f"Mean_{obj_feature}" in result.image, f"Missing Mean summary"
        assert f"Median_{obj_feature}" in result.image, f"Missing Median summary"
        assert f"Min_{obj_feature}" in result.image, f"Missing Min summary"
        assert f"Max_{obj_feature}" in result.image, f"Missing Max summary"
        assert f"StDev_{obj_feature}" in result.image, f"Missing StDev summary"
    
